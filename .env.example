# PostgreSQL (Neon). Com a integração Neon da Vercel, estas variáveis vêm de
# `vercel env pull .env.local --yes`. Pool para o app, direta para migrações.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# Obrigatório. Gere com: openssl rand -base64 32
AUTH_SECRET=""
# Mídias das OS: Vercel Blob (privado) quando definido; senão, disco local em UPLOAD_DIR
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./storage"

# Integrações: o superadmin pode informar as chaves em Configurações (salvas
# cifradas no banco). As variáveis abaixo servem de fallback.
# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Segredo do endpoint /api/stripe/webhook (Stripe Dashboard → Webhooks, ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=""
# URL pública do app (usada nos retornos do Checkout/Portal). Opcional em dev.
APP_URL=""

# Chave para cifrar as configurações salvas no painel (Configurações → APIs).
# Opcional: se vazio, deriva do AUTH_SECRET. Trocar invalida as chaves salvas.
SETTINGS_ENCRYPTION_KEY=""

# Primeiro acesso (/primeiro-acesso): código para criar a conta de superadmin
# quando o banco ainda não tem nenhum. Mínimo 12 caracteres. Remova depois.
SETUP_TOKEN=""
