// Odyssey — Gestão Condominial
// Desenvolvimento em SQLite; para produção troque o provider para "postgresql"
// e aponte DATABASE_URL para Neon/Supabase (os enums estão como String para
// manter compatibilidade entre os dois bancos).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Condominium {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  address      String?
  cnpj         String?
  phone        String?
  email        String?
  logoUrl      String?
  accentColor  String   @default("#C9A84C")
  settings     String   @default("{}")
  active       Boolean  @default(true)
  osCounter    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buildings     Building[]
  users         User[]
  categories    ServiceCategory[]
  commonAreas   CommonArea[]
  serviceOrders ServiceOrder[]
  announcements Announcement[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  payments      Payment[]
}

model Building {
  id            String      @id @default(cuid())
  condominiumId String
  name          String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  units         Unit[]
}

model Unit {
  id         String     @id @default(cuid())
  buildingId String
  number     String
  floor      Int?
  type       String     @default("apartment")
  building   Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  residents  UserUnit[]
  orders     ServiceOrder[]

  @@unique([buildingId, number])
}

/// role: superadmin | syndic | caretaker | provider | resident
/// status: active | inactive | pending
model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  phone         String?
  cpf           String?
  avatarUrl     String?
  role          String
  status        String       @default("active")
  company       String?
  specialty     String?
  failedLogins  Int          @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  condominiumId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  condominium   Condominium? @relation(fields: [condominiumId], references: [id], onDelete: SetNull)
  units         UserUnit[]
  requested     ServiceOrder[] @relation("requestedBy")
  assigned      ServiceOrder[] @relation("assignedTo")
  validated     ServiceOrder[] @relation("validatedBy")
  approved      ServiceOrder[] @relation("approvedBy")
  media         ServiceMedia[]
  events        ServiceEvent[]
  notifications Notification[]
  announcements Announcement[]
  auditLogs     AuditLog[]
  passkeys      Passkey[]
}

/// role: owner | tenant | dependent
model UserUnit {
  userId String
  unitId String
  role   String @default("owner")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
}

model ServiceCategory {
  id            String      @id @default(cuid())
  condominiumId String
  name          String
  icon          String      @default("wrench")
  color         String      @default("#C9A84C")
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  orders        ServiceOrder[]
}

model CommonArea {
  id            String      @id @default(cuid())
  condominiumId String
  name          String
  description   String?
  capacity      Int?
  reservable    Boolean     @default(false)
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  orders        ServiceOrder[]
}

/// priority: urgent | high | medium | low
/// status: open | assigned | in_progress | completed | validated | approved | rejected | cancelled
/// locationType: common_area | unit
model ServiceOrder {
  id               String    @id @default(cuid())
  protocol         String    @unique
  condominiumId    String
  title            String
  description      String
  categoryId       String?
  locationType     String
  commonAreaId     String?
  unitId           String?
  locationNote     String?
  priority         String    @default("medium")
  status           String    @default("open")
  dueDate          DateTime?
  requestedById    String
  assignedToId     String?
  validatedById    String?
  approvedById     String?
  assignedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  validatedAt      DateTime?
  approvedAt       DateTime?
  executionMinutes Int?
  materialsUsed    String    @default("[]")
  serviceReport    String?
  rating           Int?
  ratingComment    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  condominium Condominium      @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  commonArea  CommonArea?      @relation(fields: [commonAreaId], references: [id], onDelete: SetNull)
  unit        Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  requestedBy User             @relation("requestedBy", fields: [requestedById], references: [id])
  assignedTo  User?            @relation("assignedTo", fields: [assignedToId], references: [id])
  validatedBy User?            @relation("validatedBy", fields: [validatedById], references: [id])
  approvedBy  User?            @relation("approvedBy", fields: [approvedById], references: [id])
  media       ServiceMedia[]
  events      ServiceEvent[]

  @@index([condominiumId, status])
  @@index([assignedToId, status])
}

/// type: photo | video   phase: opening | before | during | after
model ServiceMedia {
  id             String       @id @default(cuid())
  serviceOrderId String
  type           String
  phase          String
  url            String
  mimeType       String
  sizeBytes      Int
  metadata       String       @default("{}")
  uploadedById   String
  uploadedAt     DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
}

/// type: created | status_change | comment | validation | approval | rejection | media | rating | assignment
model ServiceEvent {
  id             String       @id @default(cuid())
  serviceOrderId String
  userId         String
  type           String
  fromStatus     String?
  toStatus       String?
  comment        String?
  createdAt      DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
}

model Announcement {
  id            String      @id @default(cuid())
  condominiumId String
  authorId      String
  title         String
  content       String
  category      String      @default("general")
  priority      String      @default("normal")
  readBy        String      @default("[]")
  publishedAt   DateTime    @default(now())
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  title         String
  message       String
  referenceType String?
  referenceId   String?
  read          Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id            String       @id @default(cuid())
  userId        String?
  actorId       String?
  condominiumId String?
  action        String
  entityType    String
  entityId      String?
  oldValues     String?
  newValues     String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  condominium   Condominium? @relation(fields: [condominiumId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ───────────────────────────── Billing (Stripe) ─────────────────────────────

/// Planos da plataforma. Preços em centavos (BRL). Os IDs do Stripe são
/// preenchidos por lib/billing.ts (ensureStripePrices) — Prices são imutáveis,
/// então mudar o valor cria um novo Price e move a lookup_key.
model Plan {
  id                   String   @id @default(cuid())
  key                  String   @unique
  name                 String
  description          String?
  maxUnits             Int?
  monthlyPrice         Int
  yearlyPrice          Int
  features             String   @default("[]")
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  stripeProductId      String?
  stripeMonthlyPriceId String?
  stripeYearlyPriceId  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]
}

/// Espelho da assinatura Stripe de um condomínio (fonte da verdade: Stripe).
/// status: trialing | active | past_due | unpaid | canceled | incomplete | incomplete_expired | paused
model Subscription {
  id                   String    @id @default(cuid())
  condominiumId        String    @unique
  planId               String?
  interval             String    @default("month")
  status               String    @default("incomplete")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  unitAmount           Int?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  paymentMethodBrand   String?
  paymentMethodLast4   String?
  hadTrial             Boolean   @default(false)
  syncedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  plan        Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status])
}

/// Espelho das faturas Stripe. status: draft | open | paid | void | uncollectible
model Payment {
  id               String    @id @default(cuid())
  condominiumId    String
  stripeInvoiceId  String    @unique
  number           String?
  status           String
  amountDue        Int
  amountPaid       Int
  currency         String    @default("brl")
  description      String?
  periodStart      DateTime?
  periodEnd        DateTime?
  paidAt           DateTime?
  dueDate          DateTime?
  attemptCount     Int       @default(0)
  hostedInvoiceUrl String?
  invoicePdf       String?
  createdAt        DateTime  @default(now())

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@index([condominiumId, createdAt])
  @@index([status, paidAt])
}

/// Idempotência dos webhooks.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ───────────────────────────── Configurações e segurança ─────────────────────────────

/// Configurações da plataforma por grupo (stripe, security, passkeys).
/// `value` é JSON cifrado (AES-256-GCM) — ver lib/settings.ts.
model Setting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Credenciais WebAuthn (Face ID, Touch ID, Windows Hello, chaves de segurança).
model Passkey {
  id           String    @id
  userId       String
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String    @default("[]")
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
