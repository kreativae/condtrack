// Condtrack — Gestão Condominial
// Banco: PostgreSQL (Neon, provisionado pela integração do Vercel Marketplace).
// DATABASE_URL = conexão com pool (app); DATABASE_URL_UNPOOLED = direta (migrações).
// Os "enums" são String para manter o schema simples de evoluir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Condominium {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  address            String?
  cnpj               String?
  phone              String?
  email              String?
  logoUrl            String?
  accentColor        String   @default("#5B5BD6")
  settings           String   @default("{}")
  active             Boolean  @default(true)
  osCounter          Int      @default(0)
  /// Horário limite do checklist do zelador ("HH:MM", fuso de Brasília); vazio = sem alerta
  checklistDeadline  String?
  /// Último dia (YYYY-MM-DD) em que o alerta de checklist atrasado foi enviado
  checklistAlertedOn String?
  /// Conselho pode ver o Financeiro (liberado pelo síndico ou superadmin)
  councilFinanceAccess Boolean  @default(false)
  /// Condomínio de demonstração (dados fictícios, gerado pelo superadmin): pode ser excluído de verdade
  demo               Boolean  @default(false)
  /// Arquivado ("excluído") pelo superadmin: some da plataforma, mas os dados ficam guardados e podem ser restaurados
  deletedAt          DateTime?
  deletedBy          String?
  /// Pessoas que ficaram sem condomínio ativo e foram desativadas no arquivamento (reativadas ao restaurar)
  archivedUserIds    String   @default("")
  /// layout: vertical (prédios) | horizontal (casas/lotes) | mixed
  layout             String   @default("vertical")
  /// como chamar as unidades horizontais: house (Casa) | lot (Lote)
  houseNoun          String   @default("house")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  buildings      Building[]
  users          User[]
  categories     ServiceCategory[]
  commonAreas    CommonArea[]
  serviceOrders  ServiceOrder[]
  announcements  Announcement[]
  auditLogs      AuditLog[]
  subscription   Subscription?
  payments       Payment[]
  checklistItems ChecklistItem[]
  financeEntries FinanceEntry[]
  checklistNotes ChecklistNote[]
  billingDeal    BillingDeal?
  memberships    Membership[]
  maintenancePlans MaintenancePlan[]
  financeBudgets FinanceBudget[]
  assemblies     Assembly[]
}

/// kind: tower (torre/bloco, unidades por andar) | block (quadra/rua, casas ou lotes)
/// implicit: agrupamento interno de condomínio horizontal sem quadras — o nome não aparece
model Building {
  id            String      @id @default(cuid())
  condominiumId String
  name          String
  kind          String      @default("tower")
  implicit      Boolean     @default(false)
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  units         Unit[]
}

model Unit {
  id         String         @id @default(cuid())
  buildingId String
  number     String
  floor      Int?
  /// type: apartment | house | lot | commercial | other
  type       String         @default("apartment")
  building   Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  residents  UserUnit[]
  orders     ServiceOrder[]
  assemblyVotes AssemblyVote[]

  @@unique([buildingId, number])
}

/// role: superadmin | syndic | caretaker | provider | resident
/// status: active | inactive | pending
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  cpf           String?
  avatarUrl     String?
  role          String
  status        String    @default("active")
  company       String?
  specialty     String?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  condominiumId String?
  /// Ordem do menu escolhida pelo usuário (hrefs separados por vírgula; vazio = padrão do perfil)
  navOrder      String    @default("")
  /// Blocos do painel que o usuário escondeu (chaves separadas por vírgula; vazio = mostra tudo)
  dashboardHidden String  @default("")
  /// Permissões extras no condomínio ATIVO (copiadas do vínculo): checklist_edit, audit
  permissions   String    @default("")
  /// Duas etapas: segredo do app autenticador (cifrado). Sem totpEnabledAt = configuração não concluída
  totpSecret    String?
  totpEnabledAt DateTime?
  /// Último passo de 30 s aceito (o mesmo código não vale duas vezes)
  totpLastStep  Int?
  /// Hashes dos códigos de recuperação restantes, separados por vírgula
  recoveryCodes String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  condominium     Condominium?     @relation(fields: [condominiumId], references: [id], onDelete: SetNull)
  units           UserUnit[]
  requested       ServiceOrder[]   @relation("requestedBy")
  assigned        ServiceOrder[]   @relation("assignedTo")
  validated       ServiceOrder[]   @relation("validatedBy")
  approved        ServiceOrder[]   @relation("approvedBy")
  media           ServiceMedia[]
  events          ServiceEvent[]
  notifications   Notification[]
  announcements   Announcement[]
  auditLogs       AuditLog[]
  passkeys        Passkey[]
  checklistChecks ChecklistCheck[]
  financeCreated     FinanceEntry[]      @relation("financeCreatedBy")
  financeUpdated     FinanceEntry[]      @relation("financeUpdatedBy")
  financeAttachments FinanceAttachment[]
  financeLogs        FinanceLog[]
  checklistNotes     ChecklistNote[]
  passwordResets     PasswordReset[]
  memberships        Membership[]
  maintenancePlans   MaintenancePlan[]
  pushDevices        PushDevice[]
  assemblyVotes      AssemblyVote[]
}

/// role: owner | tenant | dependent
model UserUnit {
  userId String
  unitId String
  role   String @default("owner")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
}

model ServiceCategory {
  id            String         @id @default(cuid())
  condominiumId String
  name          String
  icon          String         @default("wrench")
  color         String         @default("#5B5BD6")
  condominium   Condominium    @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  orders        ServiceOrder[]
  maintenancePlans MaintenancePlan[]
}

model CommonArea {
  id             String          @id @default(cuid())
  condominiumId  String
  name           String
  description    String?
  capacity       Int?
  reservable     Boolean         @default(false)
  condominium    Condominium     @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  orders         ServiceOrder[]
  checklistItems ChecklistItem[]
  maintenancePlans MaintenancePlan[]
}

/// priority: urgent | high | medium | low
/// status: open | assigned | in_progress | completed | validated | approved | rejected | cancelled
/// locationType: common_area | unit
model ServiceOrder {
  id               String    @id @default(cuid())
  protocol         String    @unique
  condominiumId    String
  title            String
  description      String
  categoryId       String?
  locationType     String
  commonAreaId     String?
  unitId           String?
  locationNote     String?
  priority         String    @default("medium")
  status           String    @default("open")
  dueDate          DateTime?
  requestedById    String?
  assignedToId     String?
  validatedById    String?
  approvedById     String?
  assignedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  validatedAt      DateTime?
  approvedAt       DateTime?
  executionMinutes Int?
  materialsUsed    String    @default("[]")
  serviceReport    String?
  rating           Int?
  ratingComment    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  condominium Condominium      @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  commonArea  CommonArea?      @relation(fields: [commonAreaId], references: [id], onDelete: SetNull)
  unit        Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  requestedBy User?            @relation("requestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedTo  User?            @relation("assignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  validatedBy User?            @relation("validatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  approvedBy  User?            @relation("approvedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  media       ServiceMedia[]
  events      ServiceEvent[]

  @@index([condominiumId, status])
  @@index([assignedToId, status])
}

/// type: photo | video   phase: opening | before | during | after
model ServiceMedia {
  id             String       @id @default(cuid())
  serviceOrderId String
  type           String
  phase          String
  url            String
  mimeType       String
  sizeBytes      Int
  metadata       String       @default("{}")
  uploadedById   String?
  uploadedAt     DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

/// type: created | status_change | comment | validation | approval | rejection | media | rating | assignment
/// Referências a usuários ficam nulas quando o usuário é excluído ("Usuário excluído").
model ServiceEvent {
  id             String       @id @default(cuid())
  serviceOrderId String
  userId         String?
  type           String
  fromStatus     String?
  toStatus       String?
  comment        String?
  createdAt      DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Announcement {
  id            String      @id @default(cuid())
  condominiumId String
  authorId      String?
  title         String
  content       String
  category      String      @default("general")
  priority      String      @default("normal")
  readBy        String      @default("[]")
  publishedAt   DateTime    @default(now())
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  changes       AnnouncementChange[]
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  title         String
  message       String
  referenceType String?
  referenceId   String?
  read          Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id            String       @id @default(cuid())
  userId        String?
  actorId       String?
  condominiumId String?
  action        String
  entityType    String
  entityId      String?
  oldValues     String?
  newValues     String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  condominium   Condominium? @relation(fields: [condominiumId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ───────────────────────────── Billing (Stripe) ─────────────────────────────

/// Planos da plataforma. Preços em centavos (BRL). Os IDs do Stripe são
/// preenchidos por lib/billing.ts (ensureStripePrices) — Prices são imutáveis,
/// então mudar o valor cria um novo Price e move a lookup_key.
model Plan {
  id                   String   @id @default(cuid())
  key                  String   @unique
  name                 String
  description          String?
  maxUnits             Int?
  monthlyPrice         Int
  yearlyPrice          Int
  features             String   @default("[]")
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  stripeProductId      String?
  stripeMonthlyPriceId String?
  stripeYearlyPriceId  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]
}

/// Espelho da assinatura Stripe de um condomínio (fonte da verdade: Stripe).
/// status: trialing | active | past_due | unpaid | canceled | incomplete | incomplete_expired | paused
model Subscription {
  id                   String    @id @default(cuid())
  condominiumId        String    @unique
  planId               String?
  interval             String    @default("month")
  status               String    @default("incomplete")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Valor total cobrado por período (preço × quantidade), em centavos
  unitAmount           Int?
  /// Quantidade cobrada (unidades na negociação especial; 1 nos planos)
  quantity             Int       @default(1)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  paymentMethodBrand   String?
  paymentMethodLast4   String?
  hadTrial             Boolean   @default(false)
  syncedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  plan        Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status])
}

/// Espelho das faturas Stripe. status: draft | open | paid | void | uncollectible
model Payment {
  id               String    @id @default(cuid())
  condominiumId    String
  stripeInvoiceId  String    @unique
  number           String?
  status           String
  amountDue        Int
  amountPaid       Int
  currency         String    @default("brl")
  description      String?
  periodStart      DateTime?
  periodEnd        DateTime?
  paidAt           DateTime?
  dueDate          DateTime?
  attemptCount     Int       @default(0)
  hostedInvoiceUrl String?
  invoicePdf       String?
  createdAt        DateTime  @default(now())

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@index([condominiumId, createdAt])
  @@index([status, paidAt])
}

/// Idempotência dos webhooks.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ───────────────────────────── Configurações e segurança ─────────────────────────────

/// Configurações da plataforma por grupo (stripe, security, passkeys).
/// `value` é JSON cifrado (AES-256-GCM) — ver lib/settings.ts.
model Setting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Credenciais WebAuthn (Face ID, Touch ID, Windows Hello, chaves de segurança).
model Passkey {
  id         String    @id
  userId     String
  publicKey  Bytes
  counter    Int       @default(0)
  transports String    @default("[]")
  deviceType String?
  backedUp   Boolean   @default(false)
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Histórico de e-mails enviados pelo sistema (Configurações → Mensagens → Histórico).
/// type: chave do modelo (os_assigned, invite…) ou "test". status: sent | failed
model EmailLog {
  id         String   @id @default(cuid())
  type       String
  to         String
  subject    String
  status     String
  error      String?
  provider   String?
  providerId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

/// Item do checklist do zelador. frequency: daily | weekdays | weekly
/// weekdays: dias da semana separados por vírgula (0 = domingo); em "weekly", um só dia
model ChecklistItem {
  id            String           @id @default(cuid())
  condominiumId String
  title         String
  description   String?
  commonAreaId  String?
  frequency     String           @default("daily")
  weekdays      String           @default("")
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  condominium   Condominium      @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  commonArea    CommonArea?      @relation(fields: [commonAreaId], references: [id], onDelete: SetNull)
  checks        ChecklistCheck[]

  @@index([condominiumId, active])
}

/// Conferência de um item num dia (date = YYYY-MM-DD no fuso de Brasília). status: ok | issue
model ChecklistCheck {
  id             String        @id @default(cuid())
  itemId         String
  condominiumId  String
  date           String
  status         String
  note           String?
  photoUrl       String?
  userId         String?
  serviceOrderId String?
  checkedAt      DateTime      @default(now())
  item           ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([itemId, date])
  @@index([condominiumId, date])
}

/// Lançamento financeiro do condomínio. type: income | expense · status: pending | paid | cancelled.
/// Valores em centavos. Excluir é lógico (deletedAt): o histórico e as notas nunca somem.
model FinanceEntry {
  id            String              @id @default(cuid())
  condominiumId String
  type          String
  category      String
  description   String
  /// Fornecedor (despesa) ou pagador (receita)
  counterparty  String?
  /// Número da nota fiscal, boleto ou recibo
  document      String?
  amountCents   Int
  /// Data de competência
  date          DateTime
  dueDate       DateTime?
  paidAt        DateTime?
  status        String              @default("pending")
  paymentMethod String?
  notes         String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  condominium   Condominium         @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  createdBy     User?               @relation("financeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?               @relation("financeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attachments   FinanceAttachment[]
  logs          FinanceLog[]

  @@index([condominiumId, date])
}

/// Nota fiscal, boleto, recibo ou comprovante de um lançamento. kind: invoice | receipt | slip | other
model FinanceAttachment {
  id           String       @id @default(cuid())
  entryId      String
  kind         String       @default("invoice")
  url          String
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedAt   DateTime     @default(now())
  /// Removido da lista (o arquivo é mantido para o histórico)
  deletedAt    DateTime?
  entry        FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entryId])
}

/// Histórico do Financeiro: quem criou, editou, visualizou, anexou ou mudou o acesso do conselho.
/// action: created | updated | viewed | deleted | restored | attachment_added | attachment_removed | attachment_viewed | council_access
/// userName/userRole guardam o autor mesmo que o usuário seja excluído depois.
model FinanceLog {
  id            String        @id @default(cuid())
  condominiumId String
  entryId       String?
  attachmentId  String?
  userId        String?
  userName      String
  userRole      String
  action        String
  changes       String        @default("{}")
  ipAddress     String?
  createdAt     DateTime      @default(now())
  entry         FinanceEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entryId, createdAt])
  @@index([condominiumId, createdAt])
}

/// Anotação do dia no checklist (texto e fotos), por condomínio. date = YYYY-MM-DD (Brasília).
/// photos = JSON com as URLs (/api/media/checklist-<condomínio>/…). userName guarda o autor mesmo após exclusão.
model ChecklistNote {
  id            String      @id @default(cuid())
  condominiumId String
  date          String
  text          String      @default("")
  photos        String      @default("[]")
  userId        String?
  userName      String
  createdAt     DateTime    @default(now())
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([condominiumId, date])
}

/// Negociação especial de um condomínio: preço por unidade (mensal e anual), com mínimo de unidades.
/// Quando ativa, o síndico vê só esta proposta. Valores em centavos por unidade.
model BillingDeal {
  id                   String      @id @default(cuid())
  condominiumId        String      @unique
  monthlyUnitPrice     Int
  yearlyUnitPrice      Int
  minUnits             Int         @default(0)
  /// Dias de teste grátis na primeira assinatura (0 = sem teste)
  trialDays            Int         @default(0)
  notes                String?
  active               Boolean     @default(true)
  stripeProductId      String?
  stripeMonthlyPriceId String?
  stripeYearlyPriceId  String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  condominium          Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
}

/// Pedido de "esqueci minha senha": guarda só o hash do token do link (vale 1 hora, uso único).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Vínculo de um usuário com um condomínio (síndico profissional, prestador que atende vários prédios…).
/// User.condominiumId/role/permissions guardam o vínculo ATIVO; trocar de condomínio copia os dados daqui.
model Membership {
  id            String      @id @default(cuid())
  userId        String
  condominiumId String
  role          String
  permissions   String      @default("")
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@unique([userId, condominiumId])
  @@index([condominiumId, role])
}

/// Manutenção preventiva. kind: service (abre a OS sozinho, `leadDays` antes de `nextDue`, e agenda o próximo ciclo)
/// | document (AVCB, seguro, laudos: avisa antes e no vencimento, até ser marcado como renovado).
/// Periodicidade: a cada `every` `unit` (week | month | year). Datas YYYY-MM-DD (Brasília).
model MaintenancePlan {
  id            String           @id @default(cuid())
  condominiumId String
  kind          String           @default("service")
  title         String
  description   String           @default("")
  categoryId    String?
  commonAreaId  String?
  providerId    String?
  priority      String           @default("medium")
  every         Int              @default(1)
  unit          String           @default("month")
  nextDue       String
  leadDays      Int              @default(7)
  /// Documentos: último aviso enviado ("<data>" antes de vencer, "<data>!" no vencimento)
  alertedFor    String?
  lastOrderId   String?
  active        Boolean          @default(true)
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  condominium   Condominium      @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  commonArea    CommonArea?      @relation(fields: [commonAreaId], references: [id], onDelete: SetNull)
  provider      User?            @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([condominiumId, active])
  @@index([active, nextDue])
}

/// Orçamento anual por categoria (previsto × realizado no Financeiro). type: income | expense. Valor do ano, em centavos.
model FinanceBudget {
  id            String      @id @default(cuid())
  condominiumId String
  year          Int
  type          String
  category      String
  amountCents   Int
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@unique([condominiumId, year, type, category])
}

/// Aparelho inscrito nas notificações do celular/computador (Web Push). Some sozinho quando o navegador revoga a inscrição.
model PushDevice {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  /// Nome amigável do aparelho (ex.: "iPhone", "Chrome no Mac")
  name       String    @default("")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Assembleia do condomínio. kind: ordinary | extraordinary. status: draft (rascunho) | open (convocada, votação
/// aberta até votingEndsAt) | closed (encerrada; resultado e ata). Um voto por unidade em cada item (proprietários).
model Assembly {
  id               String         @id @default(cuid())
  condominiumId    String
  title            String
  kind             String         @default("ordinary")
  description      String         @default("")
  meetingAt        DateTime
  location         String         @default("")
  status           String         @default("draft")
  votingEndsAt     DateTime
  /// Votantes veem o resultado parcial antes do encerramento
  showPartial      Boolean        @default(false)
  minutes          String         @default("")
  minutesUpdatedAt DateTime?
  publishedAt      DateTime?
  closedAt         DateTime?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  condominium      Condominium    @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  items            AssemblyItem[]
  votes            AssemblyVote[]
  changes          AssemblyChange[]

  @@index([condominiumId, status])
  @@index([status, votingEndsAt])
}

/// Item da pauta. options = JSON com os rótulos (ex.: ["A favor","Contra","Abstenção"]).
model AssemblyItem {
  id          String         @id @default(cuid())
  assemblyId  String
  position    Int
  title       String
  description String         @default("")
  options     String         @default("[]")
  assembly    Assembly       @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  votes       AssemblyVote[]

  @@index([assemblyId, position])
}

/// Voto de uma unidade num item (option = índice em AssemblyItem.options). userId = quem votou pela unidade.
model AssemblyVote {
  id         String       @id @default(cuid())
  assemblyId String
  itemId     String
  unitId     String
  userId     String?
  option     Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  assembly   Assembly     @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  item       AssemblyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit       Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([itemId, unitId])
  @@index([assemblyId])
}

/// Pedido do superadmin para editar ou excluir uma assembleia publicada: só vale com a aprovação do síndico.
/// kind: edit | delete. status: pending | approved | rejected | cancelled. payload = JSON da edição proposta.
model AssemblyChange {
  id            String    @id @default(cuid())
  assemblyId    String
  kind          String
  payload       String    @default("{}")
  reason        String    @default("")
  status        String    @default("pending")
  requestedById String?
  requestedBy   String
  decidedById   String?
  decidedBy     String?
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  assembly      Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  @@index([assemblyId, status])
}

/// Pedido do superadmin para excluir um comunicado: só vale com a aprovação do síndico (como nas assembleias).
/// kind: delete. status: pending | rejected | cancelled (aprovado = comunicado apagado; o registro fica na auditoria).
model AnnouncementChange {
  id             String       @id @default(cuid())
  announcementId String
  kind           String       @default("delete")
  reason         String       @default("")
  status         String       @default("pending")
  requestedById  String?
  requestedBy    String
  decidedById    String?
  decidedBy      String?
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId, status])
}
